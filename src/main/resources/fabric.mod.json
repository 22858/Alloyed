{
  "schemaVersion": 1,
  "id": "alloyed",
  "version": "${version}",
  "name": "Alloyed",
  "description": "A mod adding Bronze and Steel, crafted in a Forge and used for compatibility and decoration!",
  "authors": [
    "cassiancc",
    "asof",
    "MythrilBagels",
    "SpottyTheTurtle",
    "Fortress Nebula"
  ],
  "contact": {
    "sources": "https://github.com/cassiancc/Alloyed",
    "issues": "https://github.com/cassiancc/Alloyed/issues",
    "homepage": "https://modrinth.com/mod/create-alloyed"
  },
  "license": "MIT",
  "icon": "alloyed.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.molybdenum.alloyed.fabric.FabricEntrypoint"
    ],
    "client": [
      "com.molybdenum.alloyed.fabric.client.FabricClientEntrypoint"
    ],
    "fabric-datagen": [
      "com.molybdenum.alloyed.fabric.FabricDataEntrypoint"
    ],
    "emi": [
      "com.molybdenum.alloyed.common.integration.emi.AlloyedEMIPlugin"
    ]
  },
  "mixins": [
    "alloyed.mixins.json"
  ],
  "accessWidener": "alloyed.accesswidener",
  "depends": {
    "minecraft": "${minecraft}",
    "fabricloader": "*",
    "fabric-api": "*"
  }
}